---
import { analyticsConfig } from '@config/index';

const { checkKey, enabled, scriptUrl, siteId } = analyticsConfig;
const shouldLoad = enabled && import.meta.env.PROD && siteId && checkKey;
const shouldLoadPublicCounter = analyticsConfig.publicCounter.enabled && import.meta.env.PROD;
---

<script
  is:inline
  define:vars={{
    analyticsEnabled: shouldLoad,
    analyticsScriptUrl: scriptUrl,
    checkKey,
    siteId,
    publicCounterEnabled: shouldLoadPublicCounter,
    publicCounterScriptUrl: analyticsConfig.publicCounter.scriptUrl,
  }}
>
  (() => {
    if (!analyticsEnabled && !publicCounterEnabled) return;

    const loadScript = (src, onLoad, id) => {
      if (document.querySelector('script[data-acorn-third-party="' + src + '"]')) return;

      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      script.charset = 'UTF-8';
      if (id) script.id = id;
      script.dataset.acornThirdParty = src;
      if (onLoad) script.addEventListener('load', onLoad, { once: true });
      document.head.append(script);
    };

    const loadThirdPartyServices = () => {
      if (analyticsEnabled) {
        loadScript(
          analyticsScriptUrl,
          () => {
            const analytics = globalThis.LA;
            if (analytics?.init && !globalThis.__acornAnalyticsInitialized) {
              analytics.init({ id: siteId, ck: checkKey });
              globalThis.__acornAnalyticsInitialized = true;
            }
          },
          'LA_COLLECT',
        );
      }

      if (publicCounterEnabled) loadScript(publicCounterScriptUrl);
    };

    const schedule = () => {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadThirdPartyServices, { timeout: 2500 });
      } else {
        window.setTimeout(loadThirdPartyServices, 0);
      }
    };

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  })();
</script>
