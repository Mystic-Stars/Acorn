---
import { Card, Tag } from '@components/animal';
import { notesConfig } from '@config/notes';
import { siteConfig } from '@config/site';
import { getNoteHref, getNoteSummary, getNoteTitle, type Note } from '@lib/notes';
import { getNoteAnchor } from '@lib/note-list';
import { getNotePreview } from '@lib/note-preview';
import { LuArrowUpRight } from 'react-icons/lu';
import FormattedDate from './FormattedDate.astro';
import NoteContent from './NoteContent.astro';

interface Props {
  note: Note;
  compact?: boolean;
}
const { note, compact = false } = Astro.props;
const anchor = getNoteAnchor(note.id);
const href = getNoteHref(note);
const preview = getNotePreview(note.body ?? '');
---

<article
  id={anchor}
  class:list={['note-entry', { compact }]}
  data-note-entry
  data-note-id={note.id}
>
  <Card className="note-surface" pattern="default">
    <header class="note-meta">
      <img src={siteConfig.branding.avatarSrc} width="36" height="36" alt="" loading="lazy" />
      <div class="note-author">
        <strong>{siteConfig.author.name}</strong><a
          href={href}
          aria-label={notesConfig.permalinkLabel}><FormattedDate date={note.data.pubDate} /></a
        >
      </div>
      {
        note.data.draft && (
          <Tag size="small" variant="dashed" color="brown">
            {notesConfig.draftLabel}
          </Tag>
        )
      }
    </header>
    <div class:list={['note-preview', { 'has-image': preview && !compact }]}>
      <div class="note-copy">
        {note.data.title && <h2>{note.data.title}</h2>}
        <p class="note-summary">{getNoteSummary(note)}</p>
      </div>
      {
        preview && !compact && (
          <a
            class="note-thumbnail"
            href={href}
            data-note-open={note.id}
            aria-haspopup="dialog"
            aria-label={`${notesConfig.readMoreLabel}：${getNoteTitle(note)}`}
          >
            <img
              src={preview.src}
              alt={preview.alt}
              width="480"
              height="300"
              loading="lazy"
              decoding="async"
            />
          </a>
        )
      }
    </div>
    <footer>
      <ul aria-label="动态标签">
        {
          note.data.tags.map((tag) => (
            <li>
              <Tag size="small" variant="outlined" color="brown">
                #{tag}
              </Tag>
            </li>
          ))
        }
      </ul>
      <a class="note-open" href={href} data-note-open={note.id} aria-haspopup="dialog">
        {notesConfig.readMoreLabel}<LuArrowUpRight size={16} aria-hidden="true" />
      </a>
    </footer>
  </Card>
  <template data-note-template={note.id} data-note-title={getNoteTitle(note)} data-note-href={href}>
    <NoteContent {note} />
  </template>
</article>

<style>
  article {
    min-width: 0;
    scroll-margin-top: calc(var(--header-offset) + var(--header-height) + 1.5rem);
  }
  article :global(.note-surface) {
    padding: 1.5rem;
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  header img {
    flex: 0 0 2.25rem;
    border-radius: var(--radius-pill);
  }
  .note-author {
    display: grid;
    gap: 0.1rem;
    flex: 1;
    min-width: 0;
  }
  .note-author strong {
    color: var(--color-text);
    font-size: 0.9375rem;
  }
  .note-author a {
    color: var(--color-text-body);
    font-size: 0.8125rem;
    text-decoration: none;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .note-summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    margin: 0;
    overflow-wrap: anywhere;
    line-height: 1.85;
  }
  .note-preview {
    margin-top: 1.15rem;
  }
  .note-preview.has-image {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 10rem;
    gap: 1.25rem;
    align-items: start;
  }
  .note-copy {
    min-width: 0;
  }
  .note-thumbnail {
    display: block;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    border-radius: var(--radius-small);
    background: var(--color-surface-secondary);
  }
  .note-thumbnail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-duration) var(--motion-easing);
  }
  .note-thumbnail:hover img {
    transform: scale(1.025);
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .note-open {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    gap: 0.35rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
  .note-open:hover {
    color: var(--color-primary-active);
  }
  .compact :global(.note-surface) {
    padding: 1.1rem;
    height: 100%;
  }
  .compact .note-summary {
    -webkit-line-clamp: 3;
    font-size: 0.9375rem;
  }
  .compact h2 {
    font-size: 1.1rem;
  }
  @media (max-width: 40rem) {
    article :global(.note-surface) {
      padding: 1.15rem;
    }
    .note-preview.has-image {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .note-thumbnail {
      max-width: 24rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .note-thumbnail img {
      transition: none;
    }
  }
</style>
